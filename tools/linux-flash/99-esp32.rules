# udev rules for ESP32 / M5Stack Cardputer USB
# Copy to /etc/udev/rules.d/ then run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# setup-fedora.sh installs this automatically.

# ESP32-S3 native USB (ROM bootloader + running firmware)
ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", MODE="0666", GROUP="dialout"

# Espressif USB JTAG/Serial (ESP32-S3 built-in)
ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", ENV{ID_MM_DEVICE_IGNORE}="1"

# CH340 USB-serial (some M5Stack accessories)
ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", GROUP="dialout"

# CP2102 USB-serial (common on dev boards)
ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", GROUP="dialout"

# FTDI FT232 (esptool programmer cables)
ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666", GROUP="dialout"
ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6010", MODE="0666", GROUP="dialout"
ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6011", MODE="0666", GROUP="dialout"
ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", MODE="0666", GROUP="dialout"
ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", MODE="0666", GROUP="dialout"
